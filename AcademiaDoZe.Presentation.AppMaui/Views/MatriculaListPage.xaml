<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaListPage"
             Title="Matriculas"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#101827}">
    <ContentPage.Resources>
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
    </ContentPage.Resources>
    <Grid Padding="18" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Picker ItemsSource="{Binding TiposFiltro}" SelectedItem="{Binding FiltroSelecionado}" Title="Filtro" />
            <Entry Grid.Column="1" Placeholder="Valor" Text="{Binding Pesquisa}" Keyboard="Numeric" WidthRequest="130" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <Button Text="Buscar" Command="{Binding PesquisarCommand}" />
            <Button Grid.Column="1" Text="Limpar" Command="{Binding LimparCommand}" BackgroundColor="{StaticResource Secondary}" />
            <Button Grid.Column="2" Text="Nova matricula" Command="{Binding NovaCommand}" />
        </Grid>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Matriculas}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="Nenhuma matricula encontrada." HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=#52616B, Dark=#BFD7F2}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,4" Padding="14" BackgroundColor="{AppThemeBinding Light=White, Dark=#172033}" Stroke="{AppThemeBinding Light=#DFE5EC, Dark=#31557D}" StrokeShape="RoundRectangle 12">
                        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="3">
                            <Label Text="{Binding AlunoMatricula.Nome}" FontAttributes="Bold" FontSize="17" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" />
                            <Label Grid.Row="1" Text="{Binding Id, StringFormat='Matricula #{0}'}" />
                            <Label Grid.Row="2" Text="{Binding AlunoMatricula.Cpf, StringFormat='CPF: {0}'}" />
                            <Label Grid.Row="3" Text="{Binding AlunoMatricula.DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" />
                            <Label Grid.Row="4" Text="{Binding Plano, Converter={StaticResource EnumDisplay}, StringFormat='Plano: {0}'}" TextColor="{AppThemeBinding Light=#52616B, Dark=#BFD7F2}" />
                            <Label Grid.Row="5" Text="{Binding DataInicio, StringFormat='Inicio: {0:dd/MM/yyyy}'}" TextColor="{AppThemeBinding Light=#52616B, Dark=#BFD7F2}" />
                            <Label Grid.Row="6" Text="{Binding DataFim, StringFormat='Termino: {0:dd/MM/yyyy}'}" TextColor="{AppThemeBinding Light=#52616B, Dark=#BFD7F2}" />
                            <Label Grid.Row="7" Text="{Binding Objetivo, StringFormat='Objetivo: {0}'}" />
                            <VerticalStackLayout Grid.Row="8" Spacing="3">
                                <Label Text="{Binding RestricoesMedicas, Converter={StaticResource EnumDisplay}, StringFormat='Restricoes: {0}'}" />
                                <Label Text="{Binding ObservacoesRestricoes, StringFormat='Observacoes: {0}'}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="1" Grid.RowSpan="9" Source="{Binding AlunoMatricula.Foto, Converter={StaticResource FotoToImageSourceConverter}}" HeightRequest="90" WidthRequest="90" Aspect="AspectFill" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="2" Grid.RowSpan="9" Spacing="6">
                                <Button Text="Editar" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditarCommand}" CommandParameter="{Binding}" />
                                <Button Text="Excluir" BackgroundColor="#9F2B2B" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoverCommand}" CommandParameter="{Binding}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator Grid.Row="2" IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" VerticalOptions="Start" HorizontalOptions="Center" />
    </Grid>
</ContentPage>
