<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:AcademiaDoZe.Presentation.AppMaui.Converters"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MinhaContaPage"
             Title="Minha conta">
    <ContentPage.Resources>
        <converters:FotoToImageSourceConverter x:Key="FotoToImageSourceConverter" />
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">
            <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="20" Padding="22">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Image x:Name="FotoImage" HeightRequest="128" WidthRequest="128" Aspect="AspectFill" BackgroundColor="White" />
                    <Label x:Name="NomeLabel" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                    <Label x:Name="PerfilLabel" FontSize="14" TextColor="White" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Frame>
            <Label Text="Dados cadastrais" FontSize="20" FontAttributes="Bold" />
            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <Label Text="CPF" FontAttributes="Bold" /> <Label x:Name="CpfLabel" Grid.Column="1" />
                <Label Grid.Row="1" Text="Nascimento" FontAttributes="Bold" /> <Label x:Name="NascimentoLabel" Grid.Row="1" Grid.Column="1" />
                <Label Grid.Row="2" Text="Telefone" FontAttributes="Bold" /> <Label x:Name="TelefoneLabel" Grid.Row="2" Grid.Column="1" />
                <Label Grid.Row="3" Text="E-mail" FontAttributes="Bold" /> <Label x:Name="EmailLabel" Grid.Row="3" Grid.Column="1" LineBreakMode="WordWrap" />
                <Label Grid.Row="4" Text="Endereco" FontAttributes="Bold" /> <Label x:Name="EnderecoLabel" Grid.Row="4" Grid.Column="1" LineBreakMode="WordWrap" />
                <Label Grid.Row="5" Text="Situacao" FontAttributes="Bold" /> <Label x:Name="SituacaoLabel" Grid.Row="5" Grid.Column="1" />
            </Grid>
            <ActivityIndicator x:Name="CarregandoIndicator" IsRunning="True" IsVisible="True" Color="{StaticResource Secondary}" />
            <Label x:Name="MensagemLabel" IsVisible="False" TextColor="{StaticResource Secondary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
