<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.DashboardPage"
             Title="Dashboard"
             Padding="{OnPlatform Android='0,20,0,0', iOS='0,20,0,0', WinUI='0', MacCatalyst='0'}"
             BackgroundColor="{AppThemeBinding Light=#F5F7FA, Dark=#101827}">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='18', Tablet='32', Desktop='48,24', Default='24'}" Spacing="20">
            <Image Source="logo_henrique.png" HeightRequest="{OnIdiom Phone=170, Tablet=230, Desktop=230, Default=200}" Aspect="AspectFit" />
            <Label Text="Academia Do Ze" FontSize="30" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}" HorizontalTextAlignment="Center" />
            <Label Text="Painel de controle" FontSize="16" TextColor="{AppThemeBinding Light=#52616B, Dark=#BFD7F2}" HorizontalTextAlignment="Center" />
            <Border BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 18" Padding="24">
                <VerticalStackLayout Spacing="6">
                    <Label Text="LOGRADOUROS CADASTRADOS" TextColor="White" FontAttributes="Bold" FontSize="13" />
                    <Label Text="{Binding TotalLogradouros}" TextColor="{StaticResource Secondary}" FontSize="44" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <Button Text="Gerenciar logradouros" Clicked="GerenciarClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
